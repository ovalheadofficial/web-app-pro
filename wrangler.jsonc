{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-pro",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e1d1432d-56b5-480a-bd49-df235e93b2be","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8c51b96618a243c495618fc21261d0f8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
